# 发版包不入库（作为 Release 附件）
dist/
*.zip
*.crx

# 密钥与证书：绝不入库
*.pem
*.key
*.p12
*.pfx

# 依赖与缓存
node_modules/
.cache/
*.log

# Chrome 用 --load-extension 直接加载本目录时，会把静态 DNR 规则编译成
# indexed ruleset 写在这里。是浏览器副产物，不是源码。
_metadata/

# 抓取的页面快照与产物（版权原因不入库）
test/fixtures/
test/**/*.html

# 用例跑出来的截图，每次重跑都会重写
test/*.png

# 下载产物示例
out/
output/

# 系统噪音
.DS_Store
Thumbs.db
desktop.ini
