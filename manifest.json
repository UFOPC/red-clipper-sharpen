{
   "action": {
      "default_icon": {
         "16": "icons/icon16.png",
         "32": "icons/icon32.png",
         "48": "icons/icon48.png",
         "128": "icons/icon128.png"
      },
      "default_title": "小红虾 · 下载助手",
      "default_popup": "setting.html"
   },
   "options_ui": {
      "page": "setting.html",
      "open_in_tab": true
   },
   "author": "AiNoMad",
   "background": {
      "service_worker": "js/background.js",
      "type": "module"
   },
   "content_scripts": [
      {
         "css": [
            "content/index.css"
         ],
         "js": [
            "js/rn-format.js",
            "content/format-size.js",
            "content/index.js"
         ],
         "matches": [
            "*://*.xiaohongshu.com/*"
         ],
         "run_at": "document_start"
      },
      {
         "css": [
            "content/discuz.css"
         ],
         "js": [
            "js/rn-format.js",
            "content/discuz.js"
         ],
         "matches": [
            "*://*.chiphell.com/*",
            "*://*.pcbeta.com/*",
            "*://*.52pojie.cn/*",
            "*://*.right.com.cn/*",
            "*://*.erji.net/*"
         ],
         "run_at": "document_idle"
      },
      {
         "css": [
            "content/sspai.css"
         ],
         "js": [
            "js/rn-format.js",
            "content/sspai.js"
         ],
         "matches": [
            "*://*.sspai.com/*"
         ],
         "run_at": "document_idle"
      },
      {
         "css": [
            "content/smzdm.css"
         ],
         "js": [
            "js/rn-format.js",
            "content/smzdm.js"
         ],
         "matches": [
            "*://post.smzdm.com/p/*"
         ],
         "run_at": "document_idle"
      },
      {
         "css": [
            "content/discuz.css"
         ],
         "js": [
            "js/rn-format.js",
            "content/wechat.js"
         ],
         "matches": [
            "*://mp.weixin.qq.com/*"
         ],
         "run_at": "document_idle"
      }
   ],
   "description": "小红虾：将小红书笔记、图片、实况与视频，以及 Chiphell / 远景 / 吾爱破解 / 恩山 / 耳机大家坛帖子、少数派文章、什么值得买文章、微信公众号文章保存到本地，自动生成 Rednote-Sharpen 格式 Markdown。",
   "host_permissions": [
      "*://*.xiaohongshu.com/*",
      "*://cdnfile.sspai.com/*",
      "*://cdn-static.sspai.com/*"
   ],
   "icons": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "小红虾 · 下载助手",
   "permissions": [
      "downloads",
      "scripting",
      "storage"
   ],
   "version": "0.8.2",
   "web_accessible_resources": [
      {
         "matches": [
            "*://*.xiaohongshu.com/*",
            "*://*.chiphell.com/*",
            "*://*.pcbeta.com/*",
            "*://*.52pojie.cn/*",
            "*://*.right.com.cn/*",
            "*://*.erji.net/*",
            "*://*.sspai.com/*",
            "*://post.smzdm.com/*",
            "*://mp.weixin.qq.com/*"
         ],
         "resources": [
            "icons/icon.svg"
         ]
      }
   ]
}
